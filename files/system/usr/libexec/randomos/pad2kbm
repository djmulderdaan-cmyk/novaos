#!/usr/bin/python3
"""RandomOS: controller -> toetsenbord + muis.

Voor games die alleen toetsenbord/muis ondersteunen (veel kleine Unity-games).
Leest alle aangesloten controllers en maakt een virtueel toetsenbord + muis.
Stopt netjes bij SIGTERM. De controller zelf blijft gewoon beschikbaar.

Eigen indeling per game via de omgevingsvariabele RANDOMOS_PADMAP (JSON), bv.
  {"a": "space", "x": "click", "lstick": "arrows", "rstick": "none"}
Knoppen: a b x y lb rb lt rt l3 r3 start select; sticks: lstick rstick; dpad.
"""
import json
import os
import select
import signal
import sys
import time

try:
    import evdev
    from evdev import ecodes as e, UInput, InputDevice
except ImportError:
    print("pad2kbm: python3-evdev ontbreekt", file=sys.stderr)
    sys.exit(1)

NAME = "RandomOS virtuele toetsenbord+muis"

# --- welke toetsen je kunt kiezen -----------------------------------------------
KEYS = {
    "space": e.KEY_SPACE, "enter": e.KEY_ENTER, "esc": e.KEY_ESC, "tab": e.KEY_TAB,
    "shift": e.KEY_LEFTSHIFT, "ctrl": e.KEY_LEFTCTRL, "alt": e.KEY_LEFTALT, "backspace": e.KEY_BACKSPACE,
    "click": e.BTN_LEFT, "rclick": e.BTN_RIGHT, "mclick": e.BTN_MIDDLE,
    "up": e.KEY_UP, "down": e.KEY_DOWN, "left": e.KEY_LEFT, "right": e.KEY_RIGHT,
}
for ch in "abcdefghijklmnopqrstuvwxyz":
    KEYS[ch] = getattr(e, "KEY_" + ch.upper())
for n in "0123456789":
    KEYS[n] = getattr(e, "KEY_" + n)

# --- standaard indeling ---------------------------------------------------------
DEFAULT = {
    "a": "space", "b": "e", "x": "r", "y": "f",
    "lb": "q", "rb": "enter", "lt": "rclick", "rt": "click",
    "l3": "shift", "r3": "c", "start": "esc", "select": "tab",
    "lstick": "wasd", "rstick": "mouse", "dpad": "arrows",
}
BUTTON_CODES = {
    "a": e.BTN_SOUTH, "b": e.BTN_EAST, "x": e.BTN_WEST, "y": e.BTN_NORTH,
    "lb": e.BTN_TL, "rb": e.BTN_TR, "l3": e.BTN_THUMBL, "r3": e.BTN_THUMBR,
    "start": e.BTN_START, "select": e.BTN_SELECT,
}
DIRS = {
    "wasd": (e.KEY_W, e.KEY_A, e.KEY_S, e.KEY_D),
    "arrows": (e.KEY_UP, e.KEY_LEFT, e.KEY_DOWN, e.KEY_RIGHT),
}

STICK_DEAD = 0.45      # stick -> toetsen vanaf deze uitslag
MOUSE_DEAD = 0.12      # stick -> muis: dode zone
MOUSE_SPEED = 22.0     # pixels per tick bij volle uitslag
TRIGGER_ON = 0.5       # analoge triggers -> knop vanaf deze waarde
TICK = 1 / 120


def load_map():
    m = dict(DEFAULT)
    try:
        user = json.loads(os.environ.get("RANDOMOS_PADMAP") or "{}")
        if isinstance(user, dict):
            for k, v in user.items():
                if k in DEFAULT and isinstance(v, str):
                    m[k] = v
    except ValueError:
        pass
    return m


def key(name):
    return KEYS.get(name)


def is_gamepad(dev):
    if dev.name == NAME:
        return False
    caps = dev.capabilities()
    keys = set(caps.get(e.EV_KEY, []))
    absx = {a[0] if isinstance(a, tuple) else a for a in caps.get(e.EV_ABS, [])}
    return (e.BTN_SOUTH in keys or e.BTN_GAMEPAD in keys) and e.ABS_X in absx


def norm(dev, code, value):
    """As-waarde naar -1..1 (sticks) of 0..1 (triggers)."""
    try:
        info = dev.absinfo(code)
    except Exception:
        return 0.0
    lo, hi = info.min, info.max
    if hi == lo:
        return 0.0
    if lo >= 0 and code in (e.ABS_Z, e.ABS_RZ, e.ABS_GAS, e.ABS_BRAKE):
        return (value - lo) / (hi - lo)
    mid = (hi + lo) / 2
    return max(-1.0, min(1.0, (value - mid) / ((hi - lo) / 2)))


def main():
    m = load_map()
    buttons = {BUTTON_CODES[b]: key(m[b]) for b in BUTTON_CODES if key(m[b])}
    # ook de D-pad als knoppen (sommige controllers melden hem zo)
    dpad = DIRS.get(m["dpad"])
    if dpad:
        buttons.update({e.BTN_DPAD_UP: dpad[0], e.BTN_DPAD_LEFT: dpad[1], e.BTN_DPAD_DOWN: dpad[2], e.BTN_DPAD_RIGHT: dpad[3]})
    lt, rt = key(m["lt"]), key(m["rt"])
    # digitale triggers (sommige controllers)
    if lt:
        buttons[e.BTN_TL2] = lt
    if rt:
        buttons[e.BTN_TR2] = rt

    out_keys = set(KEYS.values()) | {e.KEY_W, e.KEY_A, e.KEY_S, e.KEY_D}
    ui = UInput({e.EV_KEY: sorted(out_keys), e.EV_REL: [e.REL_X, e.REL_Y, e.REL_WHEEL]}, name=NAME)
    devices = {}
    state = {"lx": 0.0, "ly": 0.0, "rx": 0.0, "ry": 0.0, "lt": False, "rt": False, "hatx": 0, "haty": 0}
    held = set()
    running = [True]
    print(f"pad2kbm: indeling {json.dumps(m)}", flush=True)

    def stop(*_):
        running[0] = False
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    # meerdere bronnen kunnen dezelfde toets willen (bv. stick én D-pad op pijltjes)
    wants = {}

    def want(source, code, down):
        if code is None:
            return
        s = wants.setdefault(code, set())
        if down:
            s.add(source)
        else:
            s.discard(source)
        on = bool(s)
        if on and code not in held:
            held.add(code); ui.write(e.EV_KEY, code, 1)
        elif not on and code in held:
            held.discard(code); ui.write(e.EV_KEY, code, 0)

    def stick_keys(prefix, mode, x, y):
        d = DIRS.get(mode)
        if not d:
            return
        want(prefix + "u", d[0], y < -STICK_DEAD)
        want(prefix + "l", d[1], x < -STICK_DEAD)
        want(prefix + "d", d[2], y > STICK_DEAD)
        want(prefix + "r", d[3], x > STICK_DEAD)

    def rescan():
        for path in evdev.list_devices():
            if path in devices:
                continue
            try:
                dev = InputDevice(path)
                if is_gamepad(dev):
                    devices[path] = dev
                    print(f"pad2kbm: controller {dev.name}", flush=True)
                else:
                    dev.close()
            except Exception:
                pass

    rescan()
    last_scan = time.monotonic()
    while running[0]:
        if time.monotonic() - last_scan > 3:
            rescan(); last_scan = time.monotonic()
        fds = {dev.fd: (path, dev) for path, dev in devices.items()}
        try:
            r, _, _ = select.select(list(fds), [], [], TICK)
        except (OSError, ValueError):
            r = []
        for fd in r:
            path, dev = fds[fd]
            try:
                events = list(dev.read())
            except OSError:
                devices.pop(path, None)
                continue
            for ev in events:
                if ev.type == e.EV_KEY and ev.code in buttons:
                    want("b%d" % ev.code, buttons[ev.code], ev.value != 0)
                elif ev.type == e.EV_ABS:
                    if ev.code == e.ABS_X: state["lx"] = norm(dev, ev.code, ev.value)
                    elif ev.code == e.ABS_Y: state["ly"] = norm(dev, ev.code, ev.value)
                    elif ev.code == e.ABS_RX: state["rx"] = norm(dev, ev.code, ev.value)
                    elif ev.code == e.ABS_RY: state["ry"] = norm(dev, ev.code, ev.value)
                    elif ev.code in (e.ABS_Z, e.ABS_BRAKE): state["lt"] = norm(dev, ev.code, ev.value) > TRIGGER_ON
                    elif ev.code in (e.ABS_RZ, e.ABS_GAS): state["rt"] = norm(dev, ev.code, ev.value) > TRIGGER_ON
                    elif ev.code == e.ABS_HAT0X: state["hatx"] = ev.value
                    elif ev.code == e.ABS_HAT0Y: state["haty"] = ev.value
        # sticks -> toetsen, D-pad (hat) -> toetsen, analoge triggers -> knoppen
        stick_keys("ls", m["lstick"], state["lx"], state["ly"])
        stick_keys("rs", m["rstick"], state["rx"], state["ry"])
        if dpad:
            want("hu", dpad[0], state["haty"] < 0); want("hl", dpad[1], state["hatx"] < 0)
            want("hd", dpad[2], state["haty"] > 0); want("hr", dpad[3], state["hatx"] > 0)
        want("lt", lt, state["lt"]); want("rt", rt, state["rt"])
        # stick -> muis (met versnellingscurve)
        dx = dy = 0
        for stick in ("l", "r"):
            if m[stick + "stick"] != "mouse":
                continue
            for axis in ("x", "y"):
                v = state[stick + axis]
                if abs(v) > MOUSE_DEAD:
                    amt = ((abs(v) - MOUSE_DEAD) / (1 - MOUSE_DEAD)) ** 1.6 * MOUSE_SPEED * (1 if v > 0 else -1)
                    if axis == "x": dx += int(round(amt))
                    else: dy += int(round(amt))
        if dx: ui.write(e.EV_REL, e.REL_X, dx)
        if dy: ui.write(e.EV_REL, e.REL_Y, dy)
        ui.syn()

    for code in list(held):
        ui.write(e.EV_KEY, code, 0)
    ui.syn()
    ui.close()


if __name__ == "__main__":
    main()
