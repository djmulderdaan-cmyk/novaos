#!/usr/bin/bash
# Start RandomOS Shell als hoofdmenu van Game Mode.
# Crasht de shell? Dan gaat deze sessie verder met de gewone Steam-interface,
# zodat je nooit vastzit op een zwart scherm.

APP=/usr/lib/randomos-shell
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/randomos"
LOG="$LOG_DIR/shell.log"
mkdir -p "$LOG_DIR"
if [ -f "$LOG" ] && [ "$(stat -c%s "$LOG")" -gt 1048576 ]; then mv -f "$LOG" "$LOG.old"; fi

# Crasht de shell? Eerst opnieuw proberen (2e keer zonder GPU-versnelling), pas na 3 crashes binnen
# 3 minuten terugvallen op Steam.
failures=0
first_failure=0
extra_flags=()
while true; do
  echo "=== $(date '+%F %T') RandomOS Shell start ${extra_flags[*]} ===" >>"$LOG"
  started=$SECONDS
  "$APP/electron/electron" "$APP/app" --ozone-platform=x11 "${extra_flags[@]}" >>"$LOG" 2>&1
  code=$?
  echo "=== gestopt met code $code na $((SECONDS - started))s ===" >>"$LOG"
  [ "$code" -eq 42 ] && continue   # "Shell herstarten" uit Instellingen
  case "$code" in 0|130|143) break ;; esac

  # crash
  if [ "$failures" -eq 0 ] || [ $((SECONDS - first_failure)) -gt 180 ]; then
    failures=0
    first_failure=$SECONDS
  fi
  failures=$((failures + 1))
  if [ "$failures" -ge 3 ]; then break; fi
  if [ "$failures" -ge 2 ]; then extra_flags=(--disable-gpu); fi
  echo "Shell gecrasht ($failures), opnieuw proberen..." >>"$LOG"
  sleep 2
done

# Steam (dat zonder interface op de achtergrond draait) netjes afsluiten
stop_steam() {
  pgrep -x steam >/dev/null || return 0
  steam -shutdown >/dev/null 2>&1
  for _ in $(seq 1 60); do pgrep -x steam >/dev/null || return 0; sleep 0.5; done
  pkill -x steam; sleep 1
}

# 0 = bewust gestopt (bv. naar Steam-interface), 130/143 = afmelden of uitzetten
case "$code" in
  0|130|143) stop_steam; exit 0 ;;
esac

echo "Shell gecrasht: terugvallen op de Steam-interface" >>"$LOG"
stop_steam

if [ -n "$RANDOMOS_FALLBACK_CMD" ]; then
  eval "$RANDOMOS_FALLBACK_CMD"
else
  steam -gamepadui -steamos3 -steampal -steamdeck
fi
