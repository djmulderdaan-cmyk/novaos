# NovaOS opstartanimatie
# Donkere achtergrond, logo fadet in en "ademt" daarna zacht, dunne laadbalk eronder.

Window.SetBackgroundTopColor(0.02, 0.03, 0.09);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

# --- gloed achter het logo ---
glow.image = Image("glow.png");
glow.sprite = Sprite(glow.image);
glow.sprite.SetX(cx - glow.image.GetWidth() / 2);
glow.sprite.SetY(cy - glow.image.GetHeight() / 2);
glow.sprite.SetZ(1);
glow.sprite.SetOpacity(0);

# --- logo ---
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(cx - logo.image.GetWidth() / 2);
logo.sprite.SetY(cy - logo.image.GetHeight() / 2);
logo.sprite.SetZ(2);
logo.sprite.SetOpacity(0);

# --- laadbalk ---
bar_w = 240;
bar_y = cy + logo.image.GetHeight() / 2 + 60;

bar_bg.image = Image("bar.png").Scale(bar_w, 3);
bar_bg.sprite = Sprite(bar_bg.image);
bar_bg.sprite.SetX(cx - bar_w / 2);
bar_bg.sprite.SetY(bar_y);
bar_bg.sprite.SetZ(2);
bar_bg.sprite.SetOpacity(0);

bar.original = Image("bar.png");
bar.sprite = Sprite();
bar.sprite.SetX(cx - bar_w / 2);
bar.sprite.SetY(bar_y);
bar.sprite.SetZ(3);
bar.sprite.SetOpacity(0);

progress_now = 0;
t = 0;

fun refresh_callback () {
    t++;
    if (t < 90) {
        # eerste ~1,8 sec: rustig infaden
        a = t / 90;
        a = a * a * (3 - 2 * a);   # smoothstep
        logo.sprite.SetOpacity(a);
        glow.sprite.SetOpacity(a * 0.8);
        bar_bg.sprite.SetOpacity(a * 0.15);
        bar.sprite.SetOpacity(a * 0.9);
    } else {
        # daarna: gloed ademt zacht
        glow.sprite.SetOpacity(0.55 + 0.25 * Math.Sin((t - 90) / 30));
    }

    w = Math.Int(bar_w * progress_now);
    if (w < 1) w = 1;
    bar.sprite.SetImage(bar.original.Scale(w, 3));
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback (duration, progress) {
    progress_now = progress;
}
Plymouth.SetBootProgressFunction(progress_callback);

# Wachtwoordvraag (alleen als je schijfversleuteling gebruikt)
fun display_password_callback (prompt, bullets) {
    pw.image = Image.Text(prompt + "  " + bullets, 1, 1, 1);
    pw.sprite = Sprite(pw.image);
    pw.sprite.SetX(cx - pw.image.GetWidth() / 2);
    pw.sprite.SetY(bar_y + 40);
    pw.sprite.SetZ(4);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback () {
    pw.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
